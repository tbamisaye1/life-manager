# Life Manager — environment.
# Copy to `.env` and fill in only what you want to activate. With NOTHING set,
# the app runs fully locally on an embedded Postgres (PGlite) — zero setup.

# Backend port (frontend proxies /api here)
PORT=4000

# --- Database ---
# Leave BLANK for local dev (embedded PGlite, stored in server/db/).
# For a hosted/persistent database (production), set this to your Neon Postgres
# connection string (Neon dashboard → Connection Details → include ?sslmode=require).
# This is also the env var you set in the Vercel project settings. See DEPLOY.md.
DATABASE_URL=

# --- Google (Calendar + Gmail) ---
# Create an OAuth 2.0 Client (type: Web application) at
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/api/integrations/google/callback
# Enable the "Google Calendar API" and "Gmail API" for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback

# --- Notion ---
# Create an internal integration at https://www.notion.so/my-integrations
# For OAuth (public) integrations, also set the redirect URI below and share
# the relevant databases with the integration.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:4000/api/integrations/notion/callback
# Optional shortcut: a single internal integration token (skips OAuth)
NOTION_TOKEN=



OPENAI_API_KEY=

# App passcode gate (web + API + mobile).
# Leave UNSET for an open local demo (what cloners get).
# Set on Vercel (and optionally here for local protected mode) to lock the app.
# APP_PIN=
