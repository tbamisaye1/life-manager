# Life Manager — local environment.
# Copy to `.env` and fill in only what you want to activate. The app runs
# fully on local SQLite data without ANY of these set. None of this touches
# AWS or any Rotunda infrastructure — everything is local.

# Backend port (frontend proxies /api here)
PORT=4000

# --- Google (Calendar + Gmail) ---
# Create an OAuth 2.0 Client (type: Web application) at
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/api/integrations/google/callback
# Enable the "Google Calendar API" and "Gmail API" for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback

# --- Notion ---
# Create an internal integration at https://www.notion.so/my-integrations
# For OAuth (public) integrations, also set the redirect URI below and share
# the relevant databases with the integration.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:4000/api/integrations/notion/callback
# Optional shortcut: a single internal integration token (skips OAuth)
NOTION_TOKEN=
